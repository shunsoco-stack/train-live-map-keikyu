# Train Live Map 京急線版（非公式）
# このファイルを .env.local へコピーしてください。本番値はVercelの
# train-live-map-keikyu プロジェクトに限定し、Production / Previewへ個別設定します。
# Team Shared Environment Variablesや既存JR版の値は再利用しません。
#
#   cp .env.example .env.local
#
# 初回公開はmock-onlyです。ODPT_API_BASE_URLと
# ODPT_LIVE_DATA_APPROVED=false以外は空欄のままにします。
# 秘密値をGit、ログ、画面、Issue、CLI引数へ出さないでください。
# Firebase App Hostingを代替経路として使う場合だけ、秘密値は
# Firebase Cloud Secret Managerへ設定し、apphosting.yamlへ直書きしません。

# 公共交通オープンデータチャレンジ2026専用API
# 秘密値。ログ、画面、Issue、Gitへ出さないでください。
ODPT_ACCESS_TOKEN=
ODPT_API_BASE_URL=https://api-challenge.odpt.org/api/v4

# 安全ゲート。京急向け特定利用条件を確認し、回答記録を保存するまではfalse。
# 確認完了後だけtrueへ変更すると、トークン設定済み環境でライブ取得が有効になります。
ODPT_LIVE_DATA_APPROVED=false

# Web Push
# NEXT_PUBLIC_* はブラウザーへ公開される公開鍵です。
# VAPID_PUBLIC_KEY と同じ、新しく生成した京急版専用の公開鍵を設定します。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=

# 秘密値。京急版専用の秘密鍵を設定します。
VAPID_PRIVATE_KEY=

# mailto: または https:// で始まる運営者の連絡先。
VAPID_SUBJECT=

# みんなの情報・Push購読を保存する京急版専用KV
# 既存JR版と同じデータベース／トークンを再利用しないでください。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google AdSense クライアントID（例: ca-pub-1234567890123456）
# 初回のmock-only公開では空欄にし、広告スクリプトとads.txtを無効化します。
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# 任意。固定のバナー広告ユニットを使う場合にAdSense画面から取得するslot ID。
# 初回のmock-only公開では空欄にし、架空のIDや広告枠を表示しません。
NEXT_PUBLIC_ADSENSE_BANNER_SLOT=
